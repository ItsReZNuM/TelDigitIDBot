# Rename this file to .env and put your real values
TOKEN=123456:ABC-DEF_your_token_here
# Comma separated admin ids, e.g. 123456789,987654321
ADMIN_USER_IDS=123456789,987654321
# Optional: path to sqlite db (defaults to users.db next to database.py)
DB_PATH=users.db

# --- Force join (required-membership) feature ---
# If true, users must join the channels/groups added via the admin panel
# before they can use the bot (the bot must be an ADMIN in those chats).
ENABLE_FORCE_JOIN=true
